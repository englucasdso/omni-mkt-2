# --- Inteligência artificial (Perguntar à IA e Gerar jornada) ---------------
# Provedor: groq | gemini | openrouter | github | ollama | custom
# Todos têm camada gratuita. Depois de preencher, reinicie o OMNI e abra
# http://localhost:3000/api/ai/status?test=1 para confirmar que a IA responde.
AI_PROVIDER=groq
AI_API_KEY=
# Opcional: cada provedor já tem um modelo padrão
#   groq       llama-3.3-70b-versatile
#   gemini     gemini-2.5-flash
#   openrouter meta-llama/llama-3.3-70b-instruct:free
#   github     openai/gpt-4.1-mini
#   ollama     llama3.1
AI_MODEL=
# Só para AI_PROVIDER=custom (qualquer endpoint compatível com OpenAI)
AI_BASE_URL=
# Opcional (padrão 60000)
AI_TIMEOUT_MS=

# --- Rede corporativa ---------------------------------------------------------
# Se a máquina sai para a internet por proxy, informe aqui (o OMNI usa nas chamadas de IA)
# HTTPS_PROXY=http://proxy.empresa:8080
NO_PROXY=localhost,127.0.0.1
# Se aparecer erro de certificado, exporte o certificado raiz da empresa (.pem) e informe o caminho
# AI_CA_CERT=C:\caminho\certificado-raiz.pem

# --- Legado (ainda aceito se AI_PROVIDER estiver vazio) -----------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=
